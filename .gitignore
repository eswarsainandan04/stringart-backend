# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example

# Python Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Logs
*.log
.pytest_cache/
.coverage
htmlcov/

# User-generated assets in local storage
storage/images/*
storage/gcode/*
storage/scripts/*
!storage/images/.gitkeep
!storage/gcode/.gitkeep
!storage/scripts/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
